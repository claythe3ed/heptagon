{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heptagon.dev/schemas/cirp.schema.json",
  "title": "CIRP Plan",
  "description": "A Cyber Incident Response Plan declaration",
  "type": "object",
  "required": ["name", "version", "teams", "reporting_chain", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "teams": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["role", "members", "contact", "backup", "mandate"],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": ["response", "cyber_mgmt", "crisis_mgmt", "product_owner", "third_party"]
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "contact": { "type": "string", "minLength": 1 },
          "backup": { "type": "string", "minLength": 1 },
          "mandate": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "category", "contact", "need_to_know"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["internal", "external"] },
          "category": { "type": "string", "minLength": 1 },
          "contact": { "type": "string", "minLength": 1 },
          "need_to_know": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "reporting_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "triggers", "escalation", "key_considerations"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "triggers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "escalation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["response", "cyber_mgmt", "crisis_mgmt", "product_owner", "third_party"]
            }
          },
          "key_considerations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "training_simulations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
